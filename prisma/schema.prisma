generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum UserRole {
  USER
  PLATFORM_SUPPORT
  PLATFORM_ADMIN
}

enum HospitalRole {
  OWNER
  MANAGER
  RECEPTIONIST
  DOCTOR
  STAFF
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HospitalType {
  HOSPITAL
  CLINIC
  LAB
}

enum ConsultationMode {
  ONLINE
  PHYSICAL
}

enum BookingStatus {
  DRAFT
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PartnerInquiryStatus {
  NEW
  REVIEWED
  CONTACTED
  ONBOARDED
  REJECTED
}

enum DoctorInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum HospitalTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum HospitalTaskPriority {
  LOW
  NORMAL
  HIGH
}

enum HospitalOnboardingStatus {
  NEW
  MEETING_DONE
  DATA_REQUESTED
  DATA_RECEIVED
  DATA_ENTRY_IN_PROGRESS
  WAITING_FOR_HOSPITAL_CONFIRMATION
  READY_TO_PUBLISH
  PUBLISHED
  NEEDS_UPDATE
  CANCELLED
}

enum HospitalOnboardingFileType {
  DOCTOR_LIST
  DEPARTMENT_LIST
  SCHEDULE_LIST
  PACKAGE_LIST
  HOSPITAL_PROFILE
  LOGO
  PHOTOS
  LICENSE_DOCUMENT
  BROCHURE
  OTHER
}

enum HospitalImportType {
  DEPARTMENTS
  DOCTORS
  SCHEDULES
  PACKAGES
  MEDIA
  MIXED
}

enum HospitalImportStatus {
  UPLOADED
  PARSING
  VALIDATING
  HAS_ERRORS
  READY_TO_IMPORT
  IMPORTED
  CANCELLED
}

/**
 * =========================
 * ACCOUNTS & PATIENTS
 * =========================
 */

model User {
  id      String @id @default(cuid())
  clerkId String @unique

  fullName String
  email    String   @unique
  phone    String?
  country  String   @default("NP")
  role     UserRole @default(USER)

  bannedAt DateTime? // soft-disable without destroying history

  patients                         Patient[]
  bookings                         Booking[]
  reviews                          Review[]
  favorites                        Favorite[]
  doctorProfile                    Doctor?
  memberships                      HospitalMembership[]
  supportAssignments               SupportAssignment[]
  assignedHospitalTasks            HospitalTask[]                    @relation("HospitalTaskAssignee")
  createdHospitalTasks             HospitalTask[]                    @relation("HospitalTaskCreator")
  assignedHospitalOnboardings      HospitalOnboarding[]              @relation("HospitalOnboardingAssignee")
  createdHospitalOnboardings       HospitalOnboarding[]              @relation("HospitalOnboardingCreator")
  uploadedHospitalOnboardingFiles  HospitalOnboardingFile[]          @relation("HospitalOnboardingFileUploader")
  authoredHospitalOnboardingNotes  HospitalOnboardingNote[]          @relation("HospitalOnboardingNoteAuthor")
  completedHospitalOnboardingItems HospitalOnboardingChecklistItem[] @relation("HospitalOnboardingChecklistCompleter")
  uploadedHospitalImportBatches    HospitalImportBatch[]             @relation("HospitalImportBatchUploader")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([clerkId])
  @@index([role])
}

model Patient {
  id          String    @id @default(cuid())
  userId      String
  fullName    String
  gender      String?
  dateOfBirth DateTime?
  phone       String?
  disability  String?
  notes       String?

  archivedAt DateTime? // soft-remove: hidden from the family list/picker but bookings are preserved

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([locationId])
}

/**
 * =========================
 * LOCATION
 * =========================
 */

model Location {
  id          String  @id @default(cuid())
  country     String
  province    String?
  district    String
  city        String
  area        String?
  addressLine String?
  postalCode  String?
  lat         Float?
  lng         Float?

  hospitals Hospital[]
  patients  Patient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country, district, city])
}

/**
 * =========================
 * SPECIALTY & TAGS
 * =========================
 */

model Specialty {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  keywords    String?

  doctors     DoctorSpecialty[]
  departments HospitalDepartment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  doctors   DoctorTag[]
  hospitals HospitalTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * =========================
 * HOSPITAL
 * =========================
 */

model Hospital {
  id         String       @id @default(cuid())
  slug       String       @unique
  name       String
  type       HospitalType
  locationId String

  phone              String?
  email              String?
  website            String?
  openingHours       String?
  emergencyAvailable Boolean                  @default(false)
  servicesSummary    String?
  verified           Boolean                  @default(false)
  verifiedAt         DateTime?
  verifiedById       String?
  isActive           Boolean                  @default(true) // soft-disable without cascade delete
  suspendedAt        DateTime?
  suspendedById      String?
  suspensionReason   String?
  onboardingStatus   HospitalOnboardingStatus @default(NEW)
  publishedAt        DateTime?
  publishedById      String?

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  doctors            DoctorHospital[]
  departments        HospitalDepartment[]
  packages           HospitalPackage[]
  tags               HospitalTag[]
  media              HospitalMedia[]
  bookings           Booking[]
  reviews            Review[]
  favorites          Favorite[]
  availabilitySlots  AvailabilitySlot[]
  memberships        HospitalMembership[]
  supportAssignments SupportAssignment[]
  doctorInvites      DoctorInvite[]
  tasks              HospitalTask[]
  partnerInquiry     PartnerInquiry?
  onboarding         HospitalOnboarding?
  importBatches      HospitalImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([name])
  @@index([isActive, verified])
}

/**
 * =========================
 * HOSPITAL MEMBERSHIP (STAFF ACCESS)
 * =========================
 */

model HospitalMembership {
  id         String           @id @default(cuid())
  userId     String
  hospitalId String
  role       HospitalRole
  status     MembershipStatus @default(PENDING)

  invitedBy      String? // userId of inviter (null = self-requested)
  approvedAt     DateTime?
  approvedById   String?
  rejectedAt     DateTime?
  rejectedById   String?
  rejectedReason String? // platform admin reason on rejection

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, hospitalId])
  @@index([hospitalId, status])
  @@index([userId])
}

/**
 * =========================
 * AUDIT LOG
 * =========================
 */

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String // DB userId of who performed the action
  hospitalId  String? // null for platform-level actions
  action      String // e.g. "BOOKING_CONFIRMED", "REVIEW_HIDDEN", "MEMBER_APPROVED"
  entity      String // e.g. "Booking", "Review", "HospitalMembership"
  entityId    String // the primary key of the affected record
  before      Json? // state before the change
  after       Json? // state after the change
  ip          String? // request IP for security audit trail
  createdAt   DateTime @default(now())

  @@index([hospitalId])
  @@index([actorUserId])
  @@index([entity, entityId])
  @@index([createdAt])
}

/**
 * =========================
 * DOCTOR
 * =========================
 */

model Doctor {
  id              String  @id @default(cuid())
  userId          String? @unique
  fullName        String
  gender          String?
  experienceYears Int?
  education       String?
  bio             String?

  languages         Json?
  consultationModes Json?

  licenseNumber String?
  feeMin        Int?
  feeMax        Int?
  currency      String?
  verified      Boolean @default(false)
  dataOrigin    String  @default("MANUAL")
  sourceUrl     String?
  sourceHash    String?

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  hospitals    DoctorHospital[]
  specialties  DoctorSpecialty[]
  departments  DepartmentDoctor[]
  tags         DoctorTag[]
  services     DoctorService[]
  availability AvailabilitySlot[]
  media        DoctorMedia[]
  bookings     Booking[]
  invites      DoctorInvite[]
  reviews      Review[]
  favorites    Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([verified])
}

/**
 * =========================
 * HOSPITAL DEPARTMENTS
 * =========================
 */

model HospitalDepartment {
  id          String  @id @default(cuid())
  hospitalId  String
  specialtyId String?
  name        String
  slug        String
  overview    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  dataOrigin String  @default("IMPORTED")
  sourceUrl  String?
  sourceHash String?

  hospital  Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  specialty Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)

  doctors DepartmentDoctor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, slug])
  @@index([hospitalId, isActive, sortOrder])
}

/**
 * =========================
 * DEPARTMENT DOCTOR LISTING
 * =========================
 */

model DepartmentDoctor {
  id           String @id @default(cuid())
  departmentId String
  doctorId     String

  designation String?
  education   String?
  profileText String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  department HospitalDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  doctor     Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, doctorId])
  @@index([doctorId])
}

/**
 * =========================
 * PACKAGES
 * =========================
 */

model HospitalPackage {
  id          String  @id @default(cuid())
  hospitalId  String
  title       String
  description String?
  price       Int?
  currency    String?
  isActive    Boolean @default(true)

  dataOrigin String @default("MANUAL")

  hospital Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId, isActive])
}

/**
 * =========================
 * RELATIONS (M:N)
 * =========================
 */

model DoctorSpecialty {
  doctorId    String
  specialtyId String
  isPrimary   Boolean @default(false)

  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([doctorId, specialtyId])
}

model DoctorHospital {
  doctorId      String
  hospitalId    String
  positionTitle String?
  isPrimary     Boolean @default(false)

  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@id([doctorId, hospitalId])
}

model DoctorTag {
  doctorId String
  tagId    String

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([doctorId, tagId])
}

model HospitalTag {
  hospitalId String
  tagId      String

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([hospitalId, tagId])
}

/**
 * =========================
 * SERVICES & AVAILABILITY
 * =========================
 */

model DoctorService {
  id              String  @id @default(cuid())
  doctorId        String
  title           String
  price           Int?
  currency        String?
  durationMinutes Int?
  isActive        Boolean @default(true)
  dataOrigin      String  @default("MANUAL")
  sourceUrl       String?
  sourceHash      String?

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
}

model AvailabilitySlot {
  id                  String           @id @default(cuid())
  doctorId            String
  hospitalId          String?
  mode                ConsultationMode
  dayOfWeek           Int
  startTime           String
  endTime             String
  slotDurationMinutes Int
  isActive            Boolean          @default(true)
  dataOrigin          String           @default("MANUAL")
  sourceUrl           String?
  sourceHash          String?

  doctor   Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, hospitalId, mode, dayOfWeek, startTime, endTime])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([dayOfWeek, mode])
}

/**
 * =========================
 * MEDIA
 * =========================
 */

model DoctorMedia {
  id         String  @id @default(cuid())
  doctorId   String
  url        String
  altText    String?
  isPrimary  Boolean @default(false)
  dataOrigin String  @default("MANUAL")
  sourceUrl  String?
  sourceHash String?

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HospitalMedia {
  id         String  @id @default(cuid())
  hospitalId String
  url        String
  altText    String?
  isPrimary  Boolean @default(false)
  dataOrigin String  @default("MANUAL")
  sourceUrl  String?
  sourceHash String?

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * =========================
 * REVIEWS
 * =========================
 */

model Review {
  id         String  @id @default(cuid())
  userId     String
  hospitalId String? // nullable: a review may target a doctor instead of (or as well as) a hospital
  doctorId   String? // set for doctor-level reviews; app layer enforces at least one of hospitalId/doctorId
  rating     Int
  comment    String?

  hidden     Boolean   @default(false) // soft-hide for moderation
  hiddenById String? // userId of staff/admin who hid it
  hiddenAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctor   Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([hospitalId])
  @@index([doctorId])
  @@index([userId])
  @@index([hidden])
}

/**
 * =========================
 * FAVORITES (SAVED DOCTORS)
 * =========================
 */

model Favorite {
  id         String  @id @default(cuid())
  userId     String
  doctorId   String? // a favorite targets a doctor …
  hospitalId String? // … or a hospital (app layer enforces exactly one)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor   Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, doctorId])
  @@unique([userId, hospitalId])
  @@index([userId])
  @@index([doctorId])
  @@index([hospitalId])
}

/**
 * =========================
 * BOOKING
 * =========================
 */

model Booking {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  confirmedAt     DateTime?
  rescheduleCount Int       @default(0)

  stripeSessionId String?   @unique
  stripeRefundId  String? // set when admin cancels and Stripe refund succeeds
  refundedAt      DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  doctorId String?
  doctor   Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  packageId String?
  package   HospitalPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  availabilitySlotId String?
  availabilitySlot   AvailabilitySlot? @relation(fields: [availabilitySlotId], references: [id], onDelete: SetNull)

  mode        ConsultationMode
  scheduledAt DateTime
  slotTime    String?
  notes       String?

  amountPaid Int?
  currency   String? @default("eur")

  status BookingStatus @default(DRAFT)

  // Staff action tracking (plain strings — traced fully via AuditLog)
  cancelledAt          DateTime?
  cancelledById        String? // DB userId of staff/patient who cancelled
  cancellationReason   String?
  completedAt          DateTime?
  checkedInAt          DateTime?
  clinicalNotes        String?
  clinicalOutcome      String?
  followUpInstructions String?

  @@unique([availabilitySlotId, scheduledAt, slotTime])
  @@index([userId])
  @@index([patientId])
  @@index([hospitalId])
  @@index([doctorId])
  @@index([status, scheduledAt])
  @@index([availabilitySlotId])
  @@index([hospitalId, status, scheduledAt]) // for hospital dashboard queries
}

model HospitalTask {
  id          String               @id @default(cuid())
  hospitalId  String
  title       String
  description String?
  priority    HospitalTaskPriority @default(NORMAL)
  status      HospitalTaskStatus   @default(PENDING)
  dueAt       DateTime?

  assignedToUserId String?
  createdById      String
  completedAt      DateTime?

  hospital       Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  assignedToUser User?    @relation("HospitalTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy      User     @relation("HospitalTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId, status])
  @@index([assignedToUserId, status])
  @@index([hospitalId, dueAt])
}

/**
 * =========================
 * PARTNER INQUIRIES
 * =========================
 */

model PartnerInquiry {
  id           String               @id @default(cuid())
  hospitalId   String?              @unique
  hospitalName String
  type         HospitalType
  contactName  String
  email        String
  phone        String
  city         String
  message      String?
  status       PartnerInquiryStatus @default(NEW)
  reviewNotes  String?
  reviewedAt   DateTime?

  hospital   Hospital?           @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  onboarding HospitalOnboarding?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}

/**
 * =========================
 * HOSPITAL ONBOARDING
 * =========================
 */

model HospitalOnboarding {
  id String @id @default(cuid())

  hospitalId       String? @unique
  partnerInquiryId String? @unique

  status HospitalOnboardingStatus @default(NEW)

  assignedToUserId String?
  createdById      String

  meetingDate        DateTime?
  meetingNotes       String?
  internalNotes      String?
  dataReceivedAt     DateTime?
  dataEntryStartedAt DateTime?
  readyToPublishAt   DateTime?
  publishedAt        DateTime?

  confirmationSentAt        DateTime?
  confirmedByHospitalAt     DateTime?
  hospitalConfirmationNotes String?

  hospital       Hospital?       @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  partnerInquiry PartnerInquiry? @relation(fields: [partnerInquiryId], references: [id], onDelete: SetNull)
  assignedTo     User?           @relation("HospitalOnboardingAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("HospitalOnboardingCreator", fields: [createdById], references: [id], onDelete: Restrict)

  files     HospitalOnboardingFile[]
  notes     HospitalOnboardingNote[]
  checklist HospitalOnboardingChecklistItem[]
  imports   HospitalImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedToUserId, status])
  @@index([hospitalId])
  @@index([partnerInquiryId])
}

model HospitalOnboardingFile {
  id String @id @default(cuid())

  onboardingId String
  type         HospitalOnboardingFileType @default(OTHER)

  fileName  String
  fileUrl   String
  mimeType  String?
  sizeBytes Int?

  description  String?
  uploadedById String

  onboarding HospitalOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  uploadedBy User               @relation("HospitalOnboardingFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([onboardingId])
  @@index([type])
}

model HospitalOnboardingNote {
  id String @id @default(cuid())

  onboardingId String
  authorUserId String

  title String?
  body  String

  onboarding HospitalOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  author     User               @relation("HospitalOnboardingNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([onboardingId])
  @@index([authorUserId])
}

model HospitalOnboardingChecklistItem {
  id String @id @default(cuid())

  onboardingId String

  title       String
  description String?
  isRequired  Boolean @default(true)
  isCompleted Boolean @default(false)

  completedAt   DateTime?
  completedById String?
  sortOrder     Int       @default(0)

  onboarding  HospitalOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  completedBy User?              @relation("HospitalOnboardingChecklistCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([onboardingId, isCompleted])
}

model HospitalImportBatch {
  id String @id @default(cuid())

  onboardingId String
  hospitalId   String?

  type   HospitalImportType
  status HospitalImportStatus @default(UPLOADED)

  originalFileName String?
  fileUrl          String?

  totalRows   Int @default(0)
  successRows Int @default(0)
  errorRows   Int @default(0)

  uploadedById String

  onboarding HospitalOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  hospital   Hospital?          @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  uploadedBy User               @relation("HospitalImportBatchUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  rows HospitalImportRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([onboardingId])
  @@index([hospitalId])
  @@index([status])
}

model HospitalImportRow {
  id String @id @default(cuid())

  batchId   String
  rowNumber Int

  rawData        Json
  normalizedData Json?
  errors         Json?

  isValid          Boolean @default(false)
  importedEntity   String?
  importedEntityId String?

  batch HospitalImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([isValid])
}

model SupportAssignment {
  id            String  @id @default(cuid())
  supportUserId String
  hospitalId    String
  assignedById  String?
  notes         String?
  isActive      Boolean @default(true)

  supportUser User     @relation(fields: [supportUserId], references: [id], onDelete: Cascade)
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supportUserId, hospitalId])
  @@index([supportUserId, isActive])
  @@index([hospitalId, isActive])
}

model DoctorInvite {
  id           String             @id @default(cuid())
  hospitalId   String
  doctorId     String
  email        String
  tokenHash    String             @unique
  status       DoctorInviteStatus @default(PENDING)
  invitedById  String?
  acceptedById String?
  acceptedAt   DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId, status])
  @@index([doctorId, status])
  @@index([email, status])
  @@index([expiresAt])
}
